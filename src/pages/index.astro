---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em;
			}
			.hero {
				padding: 3em 0 2em 0;
				border-bottom: 1px solid rgba(var(--gray), 0.2);
				margin-bottom: 2em;
			}
			.hero h1 {
				font-size: 2.8rem;
				line-height: 1.1;
				margin-bottom: 0.5em;
			}
			.hero p {
				font-size: 1.25rem;
				color: rgb(var(--gray-dark));
				max-width: 700px;
				line-height: 1.6;
			}
			.section-title {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.5em;
			}
			.section-title h2 {
				margin: 0;
				font-size: 1.8rem;
			}
			.view-all {
				font-weight: 600;
				color: rgb(var(--accent));
				text-decoration: none;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5rem;
				list-style-type: none;
				padding: 0;
				margin: 0;
			}
			.card {
				background: #fff;
				border: 1px solid rgba(var(--gray), 0.2);
				border-radius: 12px;
				padding: 1.5em;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}
			.card:hover {
				transform: translateY(-3px);
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
			}
			.card a {
				text-decoration: none;
				color: inherit;
			}
			.card-title {
				font-size: 1.2rem;
				margin: 0 0 0.5rem 0;
				line-height: 1.3;
				color: rgb(var(--black));
			}
			.card-desc {
				font-size: 0.95rem;
				color: rgb(var(--gray));
				line-height: 1.5;
				margin-bottom: 1rem;
			}
			.card-date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				font-weight: 500;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>Cloud, DevOps & Homelab Engineering</h1>
				<p>
					In-depth technical architecture breakdowns, infrastructure-as-code patterns, security hardening, and hands-on sysadmin guides — generated autonomously with sovereign local AI.
				</p>
			</div>

			<div class="section-title">
				<h2>Latest Articles</h2>
				<a href="/blog" class="view-all">Browse all articles &rarr;</a>
			</div>

			<ul class="posts-grid">
				{posts.map((post) => (
					<li class="card">
						<a href={`/blog/${post.id}/`}>
							<h3 class="card-title">{post.data.title}</h3>
							<p class="card-desc">{post.data.description?.slice(0, 140)}...</p>
							<div class="card-date">
								<FormattedDate date={post.data.pubDate} />
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
