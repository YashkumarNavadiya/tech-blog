---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import profileImg from '../assets/profilepicture.jpg';
import { Image } from 'astro:assets';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About Me | ${SITE_TITLE}`}
			description="Yashkumar Navadiya — Cybersecurity Analyst, Cloud Architect & DevOps Engineer specializing in Linux hardening, SIEM, virtualization, and autonomous systems."
		/>
		<style>
			main {
				width: 860px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.about-hero {
				display: flex;
				align-items: center;
				gap: 2.5rem;
				margin-bottom: 3rem;
				padding-bottom: 2.5rem;
				border-bottom: 1px solid rgba(var(--gray), 0.2);
			}
			.avatar-wrapper {
				flex-shrink: 0;
			}
			.avatar {
				width: 180px;
				height: 180px;
				border-radius: 50%;
				object-fit: cover;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
				border: 4px solid #ffffff;
			}
			.hero-text h1 {
				font-size: 2.5rem;
				margin: 0 0 0.4rem 0;
				color: rgb(var(--black));
				line-height: 1.15;
			}
			.hero-title {
				font-size: 1.2rem;
				color: rgb(var(--accent));
				font-weight: 600;
				margin-bottom: 1rem;
			}
			.hero-desc {
				font-size: 1.05rem;
				line-height: 1.6;
				color: rgb(var(--gray-dark));
				margin: 0;
			}
			.section {
				margin-bottom: 2.5rem;
			}
			.section h2 {
				font-size: 1.6rem;
				margin-bottom: 1rem;
				color: rgb(var(--black));
			}
			.section p {
				font-size: 1.05rem;
				line-height: 1.7;
				color: rgb(var(--gray-dark));
				margin-bottom: 1.2rem;
			}
			.skills-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 1.2rem;
				margin-top: 1.5rem;
			}
			.skill-card {
				background: #ffffff;
				border: 1px solid rgba(var(--gray), 0.2);
				border-radius: 10px;
				padding: 1.2rem;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
			}
			.skill-card h3 {
				font-size: 1.1rem;
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
			}
			.skill-card p {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin: 0;
				line-height: 1.5;
			}
			.links-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				margin-top: 2rem;
				padding-top: 2rem;
				border-top: 1px solid rgba(var(--gray), 0.2);
			}
			.btn-link {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.7em 1.4em;
				border-radius: 8px;
				background: #ffffff;
				border: 1px solid rgba(var(--gray), 0.3);
				color: rgb(var(--black));
				text-decoration: none;
				font-weight: 600;
				font-size: 0.95rem;
				transition: all 0.2s ease;
			}
			.btn-link:hover {
				border-color: var(--accent);
				color: var(--accent);
				transform: translateY(-2px);
				box-shadow: 0 4px 12px rgba(35, 55, 255, 0.12);
			}
			.btn-primary {
				background: var(--accent);
				color: #ffffff;
				border-color: var(--accent);
			}
			.btn-primary:hover {
				background: var(--accent-dark);
				color: #ffffff;
			}
			@media (max-width: 720px) {
				.about-hero {
					flex-direction: column;
					text-align: center;
					gap: 1.5rem;
				}
				.links-bar {
					justify-content: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-hero">
				<div class="avatar-wrapper">
					<Image src={profileImg} alt="Yashkumar Navadiya" class="avatar" width={360} height={360} />
				</div>
				<div class="hero-text">
					<h1>Yashkumar Navadiya</h1>
					<div class="hero-title">Cybersecurity Analyst & Systems Engineer</div>
					<p class="hero-desc">
						Passionate about defensive security, cloud infrastructure architecture, containerization, and building autonomous sovereign agent systems. Based in Boston, MA.
					</p>
				</div>
			</div>

			<div class="section">
				<h2>Background & Education</h2>
				<p>
					I hold a <strong>Master’s degree in Informatics</strong> from <strong>Northeastern University</strong>, where I focused on security architecture, incident detection, and cloud defense. Prior to that, I completed my <strong>Bachelor’s in Computer Engineering</strong> at P P Savani University.
				</p>
				<p>
					My day-to-day engineering spans practical cybersecurity operations, infrastructure-as-code automation, Linux hardening, and high-availability virtualization in homelab and enterprise cloud environments.
				</p>
			</div>

			<div class="section">
				<h2>Core Specializations</h2>
				<div class="skills-grid">
					<div class="skill-card">
						<h3>🛡️ Cybersecurity & SIEM</h3>
						<p>Threat detection, vulnerability assessments, Active Directory integration, Splunk, Wazuh, Nessus, and Wireshark.</p>
					</div>
					<div class="skill-card">
						<h3>☁️ Cloud & DevOps</h3>
						<p>Infrastructure as Code, Ansible automation, Terraform provisioning, CI/CD pipelines, Docker, and Kubernetes.</p>
					</div>
					<div class="skill-card">
						<h3>🖥️ Homelab & Virtualization</h3>
						<p>Proxmox VE high availability clustering, pfSense network segmentation, VLAN architecture, and ZFS storage arrays.</p>
					</div>
					<div class="skill-card">
						<h3>🤖 Sovereign AI Systems</h3>
						<p>Architecting multi-agent operating systems (BingoOS) with local GPU inference, vision models, and sovereign automation.</p>
					</div>
				</div>
			</div>

			<div class="section">
				<h2>Certifications & Practical Labs</h2>
				<p>
					I hold industry certifications including the <strong>CompTIA PenTest+</strong> and have completed extensive hands-on defensive and offensive security scenarios on TryHackMe and HackTheBox.
				</p>
			</div>

			<div class="links-bar">
				<a href="https://yashkumarnavadiya.tech" target="_blank" rel="noopener noreferrer" class="btn-link btn-primary">
					🌐 Main Portfolio Website
				</a>
				<a href="https://www.linkedin.com/in/yashkumar-navadiya/" target="_blank" rel="noopener noreferrer" class="btn-link">
					💼 LinkedIn
				</a>
				<a href="https://github.com/YashkumarNavadiya" target="_blank" rel="noopener noreferrer" class="btn-link">
					🐙 GitHub
				</a>
				<a href="mailto:navadiya.yashkumar@gmail.com" class="btn-link">
					✉️ Email Me
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
