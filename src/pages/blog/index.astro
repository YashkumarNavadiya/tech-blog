---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const breadcrumbs = [
	{ name: 'Home', url: `${SITE_URL}/` },
	{ name: 'All Technical Articles', url: `${SITE_URL}/blog/` },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`All Technical & Quantitative Articles | ${SITE_TITLE}`}
			description={`Browse ${posts.length} production-grade engineering guides on Sovereign AI, Algorithmic Trading, Quantitative Commodities, and Cloud DevOps.`}
			breadcrumb={breadcrumbs}
		/>
		<style>
			main {
				width: 1040px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em;
			}
			.page-header {
				margin-bottom: 2.5em;
				border-bottom: 1px solid rgba(var(--gray), 0.2);
				padding-bottom: 1.5em;
			}
			.page-header h1 {
				font-size: 2.5rem;
				margin: 0 0 0.4rem 0;
				color: rgb(var(--black));
			}
			.page-header p {
				font-size: 1.15rem;
				color: rgb(var(--gray));
				margin: 0;
			}
			.article-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
				gap: 1.8rem;
				list-style-type: none;
				padding: 0;
				margin: 0;
			}
			.article-card {
				background: #ffffff;
				border: 1px solid rgba(var(--gray), 0.2);
				border-radius: 12px;
				padding: 1.6em;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
			}
			.article-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
				border-color: rgba(var(--accent), 0.4);
			}
			.article-card a {
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			.card-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.8rem;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.card-title {
				font-size: 1.25rem;
				line-height: 1.35;
				margin: 0 0 0.8rem 0;
				color: rgb(var(--black));
				font-weight: 700;
				transition: color 0.15s ease;
			}
			.article-card:hover .card-title {
				color: rgb(var(--accent));
			}
			.card-description {
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
				line-height: 1.55;
				margin: 0 0 1.2rem 0;
				flex-grow: 1;
			}
			.card-footer {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: auto;
				padding-top: 0.8rem;
				border-top: 1px solid rgba(var(--gray), 0.1);
			}
			.tag-pill {
				background: rgba(var(--gray-light), 0.7);
				color: rgb(var(--gray-dark));
				font-size: 0.75rem;
				padding: 0.2em 0.6em;
				border-radius: 6px;
				font-weight: 500;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>All Technical Articles</h1>
				<p>{posts.length} in-depth engineering breakdowns, architectural blueprints, and hardening guides.</p>
			</div>
			<ul class="article-grid">
				{posts.map((post) => (
					<li class="article-card">
						<a href={`/blog/${post.id}/`}>
							<div class="card-meta">
								<span>
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span>By {post.data.author || 'Yash'}</span>
							</div>
							<h2 class="card-title">{post.data.title}</h2>
							<p class="card-description">
								{post.data.description && post.data.description.length > 150
									? post.data.description.slice(0, 147) + '...'
									: post.data.description}
							</p>
							{post.data.tags && post.data.tags.length > 0 && (
								<div class="card-footer">
									{post.data.tags.slice(0, 3).map((tag: string) => (
										<span class="tag-pill">#{tag}</span>
									))}
								</div>
							)}
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
