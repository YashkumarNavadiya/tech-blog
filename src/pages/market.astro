---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="ApexMarket — Real-Time Global Market Terminal | Yashkumar Navadiya" 
			description="Live institutional-grade global market terminal tracking Top 100 Equities, Cryptocurrencies, Precious Metals, Energy & Oil, and Foreign Exchange." 
		/>
		<meta http-equiv="refresh" content="0; url=https://market.yashkumarnavadiya.tech" />
		<style>
			body {
				margin: 0;
				padding: 0;
				background-color: #0b0f19;
				color: #f8fafc;
				font-family: system-ui, -apple-system, sans-serif;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				text-align: center;
			}
			.card {
				background: #0f172a;
				border: 1px solid #1e293b;
				padding: 2.5rem;
				border-radius: 1rem;
				max-width: 500px;
				box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
			}
			h1 {
				font-size: 1.5rem;
				margin-bottom: 0.5rem;
				color: #38bdf8;
			}
			p {
				color: #94a3b8;
				font-size: 0.95rem;
				margin-bottom: 1.5rem;
			}
			a.btn {
				display: inline-block;
				background: #2563eb;
				color: #ffffff;
				text-decoration: none;
				padding: 0.75rem 1.5rem;
				border-radius: 0.5rem;
				font-weight: 600;
				font-size: 0.95rem;
				transition: background 0.2s;
			}
			a.btn:hover {
				background: #1d4ed8;
			}
		</style>
	</head>
	<body>
		<div class="card">
			<div style="font-size: 2.5rem; margin-bottom: 1rem;">🌐</div>
			<h1>ApexMarket Terminal</h1>
			<p>Redirecting you to the dedicated real-time market terminal on <strong>market.yashkumarnavadiya.tech</strong>...</p>
			<a class="btn" href="https://market.yashkumarnavadiya.tech">Launch Live Market Terminal ↗</a>
		</div>
	</body>
</html>
