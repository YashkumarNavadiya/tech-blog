---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_URL, AUTHOR_NAME } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	body?: string;
	id?: string;
};

const { title, description = '', pubDate, updatedDate, heroImage, author = AUTHOR_NAME, tags = [], body = '', id = '' } = Astro.props;

// Calculate estimated reading time
const words = body.replace(/---[\s\S]*?---/, '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(2, Math.ceil(words / 225));

// Breadcrumb for UI and Schema
const breadcrumbs = [
	{ name: 'Home', url: `${SITE_URL}/` },
	{ name: 'Blog', url: `${SITE_URL}/blog/` },
	{ name: title, url: `${SITE_URL}/blog/${id}/` },
];
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} | Yash's Tech & Quant Blog`}
			description={description}
			image={heroImage}
			type="article"
			article={{
				pubDate,
				updatedDate,
				author,
				tags,
				section: tags[0] || 'Engineering',
			}}
			breadcrumb={breadcrumbs}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.breadcrumbs {
				max-width: 820px;
				margin: 1.5rem auto 0 auto;
				padding: 0 1rem;
				font-size: 0.88rem;
				color: rgb(var(--gray));
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.4rem;
			}
			.breadcrumbs a {
				color: rgb(var(--gray));
				text-decoration: none;
				transition: color 0.15s ease;
			}
			.breadcrumbs a:hover {
				color: var(--accent);
			}
			.breadcrumbs .separator {
				color: rgba(var(--gray), 0.5);
			}
			.breadcrumbs .current {
				color: rgb(var(--black));
				font-weight: 500;
				max-width: 320px;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.hero-image {
				width: 100%;
				max-width: 820px;
				margin: 1.5rem auto 0 auto;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 820px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em 1em 3em 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 2em;
				padding: 1.2em 0;
				border-bottom: 1px solid rgba(var(--gray), 0.2);
			}
			.title h1 {
				font-size: 2.3rem;
				line-height: 1.25;
				margin: 0.6rem 0 0.8rem 0;
				color: rgb(var(--black));
			}
			.post-meta-bar {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 1.2rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin-bottom: 0.8rem;
			}
			.meta-item {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}
			.last-updated-on {
				font-style: italic;
				color: rgb(var(--gray));
			}
			.tags-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				margin-top: 0.8rem;
			}
			.tag-badge {
				background: rgba(var(--gray-light), 0.8);
				color: rgb(var(--gray-dark));
				font-size: 0.8rem;
				padding: 0.22em 0.7em;
				border-radius: 6px;
				font-weight: 500;
				letter-spacing: 0.02em;
			}
			.author-box {
				margin-top: 3.5em;
				padding: 1.6em;
				background: #ffffff;
				border: 1px solid rgba(var(--gray), 0.2);
				border-radius: 12px;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
				display: flex;
				align-items: center;
				gap: 1.5rem;
			}
			.author-box img {
				width: 72px;
				height: 72px;
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid var(--accent);
			}
			.author-info h3 {
				font-size: 1.15rem;
				margin: 0 0 0.3rem 0;
				color: rgb(var(--black));
			}
			.author-info p {
				font-size: 0.92rem;
				margin: 0 0 0.5rem 0;
				color: rgb(var(--gray-dark));
				line-height: 1.5;
			}
			.author-link {
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
			}
			.author-link:hover {
				text-decoration: underline;
			}
			.post-nav {
				margin-top: 2em;
				text-align: center;
			}
			.back-link {
				display: inline-block;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
				padding: 0.5em 1.2em;
				border: 1px solid rgba(var(--accent), 0.3);
				border-radius: 8px;
				transition: background 0.15s ease, border-color 0.15s ease;
			}
			.back-link:hover {
				background: rgba(var(--accent), 0.06);
				border-color: var(--accent);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<nav aria-label="Breadcrumb" class="breadcrumbs">
				<a href="/">Home</a>
				<span class="separator">/</span>
				<a href="/blog">Blog</a>
				<span class="separator">/</span>
				<span class="current" title={title}>{title}</span>
			</nav>

			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<header class="title">
						<div class="post-meta-bar">
							<span class="meta-item">
								📅 <FormattedDate date={pubDate} />
							</span>
							{updatedDate && (
								<span class="meta-item last-updated-on">
									(Updated: <FormattedDate date={updatedDate} />)
								</span>
							)}
							<span class="meta-item">
								⏱️ {readingTime} min read
							</span>
							<span class="meta-item">
								✍️ {author}
							</span>
						</div>
						<h1>{title}</h1>
						{tags && tags.length > 0 && (
							<div class="tags-row">
								{tags.map((tag: string) => (
									<span class="tag-badge">#{tag}</span>
								))}
							</div>
						)}
					</header>

					<slot />

					<!-- E-E-A-T Author Card for Google Search Authority -->
					<div class="author-box">
						<img src="/favicon.svg" alt={author} />
						<div class="author-info">
							<h3>About {author}</h3>
							<p>Systems Architect, Cybersecurity Specialist & Quantitative Engineering Researcher. Authoring production-grade guides on Sovereign AI, Algorithmic Trading, Linux Security, and Distributed Cloud Infrastructure.</p>
							<a href="/about/" class="author-link">View Full Bio & Experience &rarr;</a>
						</div>
					</div>

					<div class="post-nav">
						<a href="/blog" class="back-link">&larr; Back to All 70+ Technical Articles</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
