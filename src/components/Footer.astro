<style>
	footer {
		background: #fbfbfd;
		border-top: 1px solid rgba(var(--gray), 0.15);
		color: rgb(var(--gray));
		text-align: center;
		padding: 3em 1em 4em;
		margin-top: 4em;
	}
	.footer-content {
		max-width: 720px;
		margin: auto;
	}
	.copyright {
		margin: 0 0 0.4em 0;
		font-weight: 600;
		color: rgb(var(--black));
	}
	.tagline {
		margin: 0 0 1.5em 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}
	.social-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1.2em;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: #ffffff;
		border: 1px solid rgba(var(--gray), 0.2);
		color: rgb(var(--gray));
		text-decoration: none;
		transition: all 0.2s ease;
	}
	.social-links a:hover {
		color: var(--accent);
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(35, 55, 255, 0.15);
	}
</style>
